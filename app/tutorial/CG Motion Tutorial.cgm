{"app":"cgmotion","version":1,"name":"CG Motion Tutorial","rootComp":"crrskx28","comps":[{"id":"crrskx28","name":"Lower third","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"lddh89wk","name":"News crawl","type":"crawl","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":1030,"w":1920,"h":56,"fontSize":30,"color":"#ffffffff","bg":"#141414e6","ax":960,"ay":28},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"crawl","text":"SPORT^Proteas win by 5 wickets | WEATHER^Sunny in Durban, 26°C | NEXT^Australia v India at 14:00","itemSep":"|","sepText":"•","sepColor":"#00ff83ff","gap":60,"speed":160,"fade":40,"styles":{"on":true,"sep":"^","join":"  ","segs":[{"weight":700,"color":"#00ff83"},{}]}},{"id":"l1zbc625","name":"Role","type":"text","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":192,"y":912,"fontSize":26,"color":"#00ff83ff","w":600,"h":40,"ax":0,"ay":0},"a":{"op":[{"t":25,"v":0,"e":{"type":"linear"}},{"t":40,"v":100,"e":{"type":"linear"}}]},"mask":{"on":false,"shape":"rect"},"shadow":false,"text":"Captain  ·  Proteas","font":"Arial","weight":400,"align":"left","key":"role","maxW":0,"wrapW":0,"box":true,"boxWrap":false,"valign":"top"},{"id":"l894174j","name":"Player name","type":"text","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"lkxui69s","matteMode":"alpha","blend":"normal","p":{"x":190,"y":845,"fontSize":54,"color":"#ffffffff","w":600,"h":72,"ax":0,"ay":0},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"text":"Temba|Bavuma|C","font":"Arial","weight":400,"align":"left","key":"name","maxW":0,"wrapW":0,"box":true,"boxWrap":false,"squeeze":true,"valign":"middle","styles":{"on":true,"sep":"|","join":" ","segs":[{"weight":300,"italic":"on"},{"weight":700,"caps":"upper","italic":"off"},{"weight":700,"size":55,"raise":35,"before":"(","after":")","italic":"off"}]}},{"id":"lkxui69s","name":"Name wipe","type":"shape","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":160,"y":840,"w":820,"h":120,"ax":0,"ay":0,"fill":"#ffffffff"},"a":{"w":[{"t":12,"v":0,"e":{"type":"preset","id":"e_snapout"}},{"t":40,"v":820,"e":{"type":"linear"}}]},"mask":{"on":false,"shape":"rect"},"shadow":false,"shape":"rect","gradient":false},{"id":"l6ngtgih","name":"Logo slot","type":"image","start":0,"end":250,"visible":true,"locked":false,"parent":"lssjoicc","matte":"","matteMode":"alpha","blend":"normal","p":{"x":760,"y":10,"w":100,"h":100,"ax":0,"ay":0},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"asset":"","key":"logo","fit":"contain","prefix":"","suffix":""},{"id":"lzuk2fqz","name":"Accent","type":"shape","start":0,"end":250,"visible":true,"locked":false,"parent":"lssjoicc","matte":"","matteMode":"alpha","blend":"normal","p":{"x":0,"y":0,"w":14,"h":120,"ax":0,"ay":0,"fill":"#00ff83ff"},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"shape":"rect","gradient":false},{"id":"lssjoicc","name":"Name bar","type":"shape","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":560,"y":900,"w":860,"h":120,"ax":430,"ay":60,"fill":"#202020f2","texOp":25},"a":{"x":[{"t":0,"v":-500,"e":{"type":"preset","id":"e_snapout"}},{"t":25,"v":560,"e":{"type":"preset","id":"e_snapout"}},{"t":205,"v":560,"e":{"type":"preset","id":"e_snapin"}},{"t":230,"v":-500,"e":{"type":"linear"}}]},"mask":{"on":false,"shape":"rect"},"shadow":false,"shape":"rect","gradient":false,"tex":{"on":true,"kind":"brushed","blend":"overlay","scale":100}}],"markers":[{"t":60},{"t":200}],"loops":[{"from":90,"to":150}],"note":"A player lower third with a crawl.\n\n- Name bar: slides in with keyframes and a Snappy out ease.\n- Accent: parented to the name bar (see the node screen).\n- Name wipe: a mask that reveals the name; it is hidden itself.\n- Player name: Text styles with the Name SURNAME (C) preset. In the Control panel try name = Siya|Kolisi|C, then Siya|Kolisi.\n- Logo slot: an image slot; send a picture path in the logo field.\n- Crawl: items split by |, each styled with ^ (LABEL^text).\n\nTimeline: stops at 60 (play) and 200 (out), a repeat section from 90 to 150, and a flash invoke from 150 to 175. Test them with Play, Next, Stop and flash in the Control panel."},{"id":"ccflho7m","name":"Standings","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"llx3s6gw","name":"Standings table","type":"table","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":1100,"h":380,"fontSize":34,"color":"#ffffffff","fill":"#202020e6","fill2":"#2b2b2be6","bg":"#00ff83ff","stroke":"#00000066","strokeW":1,"ax":550,"ay":190},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"standings","rows":"Pos|Team|P|W|L|Pts\n1|Proteas|6|5|1|22\n2|Australia|6|4|2|18\n3|India|6|4|2|17\n4|England|6|2|4|10\n5|New Zealand|6|1|5|5","header":true,"cols":"1,4,1,1,1,1.3","aligns":"c,l,c,c,c,c","headColor":"#06210fff","reveal":"slide","stagger":4,"revealDur":10}],"markers":[{"t":100}],"note":"A league table.\n\n- Rows are typed in the Inspector, one per line, cells split by |. You can also paste straight from Excel.\n- The first row is a header with its own fill and text colour.\n- Rows slide in one after another (Rows come in).\n- Filled from CasparCG is ticked, so the standings field replaces the rows on air: try it in the Control panel.\n- Every cell is its own field too: standings_r1c2 is row 1, cell 2; standings_h6 is header cell 6; standings_r6 adds a whole row. Point at a cell in the Data panel to see its field name.\n- The Data panel (Window > Data) edits the rows in a grid."},{"id":"crp1e06v","name":"Worm","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"l80twvea","name":"Worm chart","type":"chart","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":1300,"h":640,"fontSize":26,"color":"#ffffffff","bg":"#00000000","strokeW":5,"ax":650,"ay":320},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"worm","chart":"line","cumul":true,"legend":true,"anim":50,"data":"Proteas: 4, 8, 3, 12w, 6, 9, 2, 14, 7, 10w, 5, 8\nAustralia: 6, 2, 10, 5, 7w, 11, 4, 8w, 13, 6, 9, 3w"}],"markers":[{"t":100}],"note":"A cricket worm.\n\n- One team per line: \"Proteas: 4, 8, 3, 12w\". The w marks a wicket in that over.\n- Add up the values is ticked, so runs per over become the running total.\n- The chart draws on over 50 frames from its In frame.\n- Send new overs in the worm field from the Control panel, or one series at a time: worm_v1 = all Proteas overs, worm_v1p13 = over 13 only, worm_n2 = second team name, worm_c1 = Proteas colour."},{"id":"cwhqvo85","name":"Manhattan","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"l3j04eee","name":"Manhattan chart","type":"chart","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":1300,"h":600,"fontSize":26,"color":"#ffffffff","bg":"#00000000","strokeW":5,"ax":650,"ay":300},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"manhattan","chart":"bar","cumul":false,"legend":true,"anim":50,"data":"Proteas: 4, 8, 3, 12w, 6, 9, 2, 14\nAustralia: 6, 2, 10, 5, 7w, 11, 4, 8w"}],"markers":[{"t":100}],"note":"Runs per over as bars, side by side per team, with dots for wickets. Same data format as the worm, without adding up."},{"id":"c2l6reed","name":"Poll","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"l810splt","name":"Poll donut","type":"chart","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":700,"h":640,"fontSize":28,"color":"#ffffffff","bg":"#00000000","strokeW":5,"ax":350,"ay":320},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"poll","chart":"donut","cumul":false,"legend":true,"anim":50,"data":"Yes: 62\nNo: 31\nUnsure: 7"}],"markers":[{"t":100}],"note":"A donut for a viewer poll. One item per line: \"Yes: 62\". Labels show percentages; the legend lists the items. Switch the type to Pie in the Inspector to compare."},{"id":"c0f8mwp2","name":"Votes","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"lxmr1ct3","name":"Vote bars","type":"chart","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":1200,"h":360,"fontSize":32,"color":"#ffffffff","bg":"#00000000","strokeW":5,"ax":600,"ay":180},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"votes","chart":"hbar","cumul":false,"legend":false,"anim":50,"data":"Bavuma: 48\nRabada: 33\nMarkram: 19","suffix":"%"}],"markers":[{"t":100}],"note":"Horizontal bars for a vote, with % after the values (After values). One item per line."},{"id":"ct0f1ok7","name":"Stats","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"lhvyzj26","name":"Stat bars","type":"chart","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":1100,"h":620,"fontSize":32,"color":"#ffffffff","bg":"#00000000","strokeW":5,"ax":550,"ay":310},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"font":"Arial","weight":400,"key":"stats","chart":"dual","cumul":false,"legend":false,"anim":40,"data":"Proteas | Australia\nRuns: 238 | 241\nRun rate: 4.76 | 4.82\nFours: 22 | 18\nSixes: 6 | 9\nExtras: 11 | 7\nDot balls: 54% | 49%","colors":"#00ff83, #3b9dff","pad":36,"barRadius":3},{"id":"lnhrhkxu","name":"Stats panel","type":"shape","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"w":1160,"h":680,"ax":580,"ay":340,"fill":"#1b1f22f2","radius":12,"texOp":60},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"shape":"rect","gradient":false,"tex":{"on":true,"kind":"carbon","blend":"overlay","scale":100}}],"markers":[{"t":100}],"note":"A head-to-head stat comparison with double bars.\n\n- First line: the two names, \"Proteas | Australia\". Then one stat per line: \"Fours: 22 | 18\".\n- Each pair of bars grows out from the middle, scaled to the bigger value; the leader is highlighted.\n- Values keep their units and count up as the bars grow.\n- Tick One split bar per stat for a possession-style bar that shows each side's share.\n- Send new numbers in the stats field from the Control panel.\n- Stats panel: a shape with the Carbon texture laid over it (Texture in the Inspector).\n- Single values on air: stats_a3 / stats_b3 are the two values of stat 3, stats_n1 / stats_n2 the names."},{"id":"cu95fnkd","name":"Quote","w":1920,"h":1080,"fps":50,"duration":250,"bg":"#3a4a5a","layers":[{"id":"lebbfexs","name":"Quote","type":"text","start":0,"end":250,"visible":true,"locked":false,"parent":"","matte":"","matteMode":"alpha","blend":"normal","p":{"x":960,"y":540,"fontSize":64,"color":"#ffffffff","w":900,"h":260,"bg":"#202020e6","ax":450,"ay":130,"texOp":40},"a":{},"mask":{"on":false,"shape":"rect"},"shadow":false,"text":"\"We played with real belief today\\nand the bowlers set it up for us.\"\\n- Temba Bavuma","font":"Arial","weight":400,"align":"left","key":"quote","maxW":0,"wrapW":0,"box":true,"boxWrap":true,"fitBox":true,"valign":"middle","padL":30,"padR":30,"padT":20,"padB":20,"tex":{"on":true,"kind":"grain","blend":"overlay","scale":100,"motion":"flicker","rate":12,"amount":300,"fade":"edges","feather":60}}],"markers":[{"t":100}],"note":"A multiline quote in a text box.\n\n- Press Enter in the text, or send \\n in the quote field, for a new line.\n- Shrink the text until every line fits the box is ticked: send a longer quote and the text gets smaller instead of spilling out.\n- The box has a Film grain texture with the Film flicker motion and soft edges (Texture in the Inspector): play it to see the grain move."}],"assets":{},"easings":[{"id":"e_ease","name":"Ease","b":[0.33,0,0.67,1]},{"id":"e_in","name":"Ease in","b":[0.42,0,1,1]},{"id":"e_out","name":"Ease out","b":[0,0,0.58,1]},{"id":"e_smooth","name":"Smooth","b":[0.65,0,0.35,1]},{"id":"e_snapout","name":"Snappy out","b":[0.16,1,0.3,1]},{"id":"e_snapin","name":"Snappy in","b":[0.7,0,0.84,0]},{"id":"e_over","name":"Overshoot","b":[0.34,1.56,0.64,1]},{"id":"e_antic","name":"Anticipate","b":[0.36,0,0.66,-0.56]}],"actions":[{"id":"x1","name":"flash","target":"main","comp":"crrskx28","from":150,"to":175}],"swatches":[],"defaultEase":{"type":"linear"},"dataKeys":1,"caspar":{"host":"127.0.0.1","port":5250,"channel":1,"layer":20,"folder":""}}